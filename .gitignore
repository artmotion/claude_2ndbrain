# Dependencies and build output (every workspace)
node_modules/
.turbo/
dist/
dist-ssr/
target/

# Local environment and secrets
.env
.env.*
!.env.example
*.local

# Logs and OS/editor noise
*.log
.DS_Store
.idea/

# Claude Code agent worktrees (local only)
.claude/worktrees/

# Self-host data (deploy/compose bind mounts): never commit it
/data/
# Cloudflare Tunnel config and credentials (secret); only the example is tracked
/deploy/compose/cloudflared/*
!/deploy/compose/cloudflared/config.yml.example
