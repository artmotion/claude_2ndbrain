{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:wait": "node scripts/wait-for-db.mjs",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:deploy": "node dist/db/migrate.js",
    "seed:demo": "tsx scripts/demo/seed-demo-org.ts",
    "seed:demo:reset": "tsx scripts/demo/seed-demo-org.ts --reset",
    "demo:activity": "tsx scripts/demo/simulate-activity.ts",
    "demo": "tsx scripts/demo/seed-demo-org.ts --reset && tsx scripts/demo/simulate-activity.ts",
    "set-password": "tsx src/scripts/set-password.ts",
    "blobs:migrate": "tsx src/scripts/migrate-blobs.ts",
    "recover:notes": "tsx src/scripts/recover-notes.ts",
    "test": "vitest run && node --test housekeeper/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@better-auth/mcp": "^1.7.15",
    "@better-auth/oauth-provider": "^1.7.15",
    "@hocuspocus/extension-redis": "^4.8.0",
    "@hocuspocus/server": "^4.8.0",
    "@hono/node-server": "^2.1.5",
    "@node-rs/argon2": "^2.2.2",
    "@openrouter/sdk": "1.5.33",
    "better-auth": "^1.7.15",
    "dotenv": "^17.2.3",
    "file-type": "^22.3.0",
    "hono": "^4.13.16",
    "ioredis": "^5.11.1",
    "jose": "^6.2.14",
    "kysely": "^0.29.8",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "standardwebhooks": "^1.1.1",
    "ws": "^8.22.1",
    "yjs": "catalog:"
  },
  "devDependencies": {
    "@hocuspocus/provider": "catalog:",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "y-protocols": "catalog:"
  }
}
